"""Completed-E3 adapter workflow with human, evidence-led and smoke-test routes.

This DAG consumes, but never modifies, the completed predecessor.  It stages an
editable review authority outside the immutable preparation bundle, then stops
until a separately issued checksum-bound curator approval exists.  Once that
approval is present, the remaining campaign can run unattended to independent
post-publication verification.  An explicitly requested automated test route
creates conspicuously synthetic labels and approval authorities for software
testing only; those outputs are never scientifically interpretable.
The evidence-led route generates abstention-aware provisional labels, matched
controls and circularity-exclusion ledgers. It can continue unattended only
after the launcher receives an explicit provisional-evidence acceptance flag.
"""

import shlex
from pathlib import Path


def setting_text(name, default=""):
    """Return one trimmed setting while treating YAML null as empty."""

    value = config.get(name, default)
    return "" if value is None else str(value).strip()


def required_path(name):
    """Resolve one required absolute path supplied through Snakemake config."""

    value = setting_text(name)
    if not value:
        raise ValueError(f"{name} must be supplied through --config.")
    source = Path(value).expanduser()
    if not source.is_absolute():
        raise ValueError(f"{name} must be absolute: {value}")
    return source.resolve()


def positive_integer(name, default):
    """Return one positive integer workflow setting."""

    value = int(config.get(name, default))
    if value < 1:
        raise ValueError(f"{name} must be a positive integer.")
    return value


def boolean_setting(name, default=False):
    """Return one strict Boolean workflow setting."""

    value = config.get(name, default)
    if isinstance(value, bool):
        return value
    normalised = str(value).strip().lower()
    if normalised in {"true", "1", "yes"}:
        return True
    if normalised in {"false", "0", "no"}:
        return False
    raise ValueError(f"{name} must be true or false.")


def optional_file(name):
    """Resolve one optional absolute existing input file."""

    value = setting_text(name)
    if not value:
        return None
    source = Path(value).expanduser()
    if not source.is_absolute() or not source.is_file():
        raise ValueError(f"{name} must be an existing absolute file: {value}")
    return source.resolve()


def optional_cli_argument(option, value):
    """Return one shell-quoted optional named CLI argument."""

    return "" if value is None else f"{option} {shlex.quote(str(value))}"


RUN_ROOT = required_path("e3_run_root")
WORK_DIR = required_path("e3_work_dir")
PREPARED_DIR = WORK_DIR / "prepared_inputs"
REVIEWED_LABELS = Path(
    str(config.get("e3_reviewed_labels", WORK_DIR / "reviewed_label_assignments.tsv"))
).expanduser().resolve()
STATE_DIR = WORK_DIR / "workflow_state" / "e3"
APPROVAL_MARKER = Path(
    str(
        config.get(
            "e3_review_approval",
            STATE_DIR / "02_label_review" / "REVIEW_APPROVED.json",
        )
    )
).expanduser().resolve()
CAMPAIGN_CONFIG = WORK_DIR / "campaign.yaml"
RESULT_DIR = WORK_DIR / "result"
CAMPAIGN_ID = setting_text("e3_campaign_id")
PROFILE = setting_text("e3_profile", "e3")
MINIMUM_MEAN_PLDDT = float(config.get("e3_minimum_mean_plddt", 50.0))
ANALYSIS_THREADS = positive_integer("e3_threads", 24)
ANALYSIS_MEMORY_MB = positive_integer("e3_memory_mb", 128_000)
ANALYSIS_RUNTIME_MINUTES = positive_integer("e3_runtime_minutes", 2_880)
LOG_LEVEL = setting_text("e3_log_level", "INFO")
AUTOMATED_TEST_LABELS = boolean_setting("e3_automated_test_labels")
EVIDENCE_LED_LABELS = boolean_setting("e3_evidence_led_labels")
ACCEPT_PROVISIONAL_EVIDENCE = boolean_setting(
    "e3_accept_provisional_evidence_labels"
)
EVIDENCE_RULES = setting_text("e3_evidence_rules", "e3")
SEED_ASSIGNMENTS = optional_file("e3_seed_assignments")
SEED_CATALOGUE = optional_file("e3_seed_catalogue")
EXTERNAL_ANNOTATIONS = optional_file("e3_external_annotations")
TEST_TARGET_LABEL = setting_text("e3_test_target_label", "ALL")
TEST_SAMPLES_PER_CLASS = positive_integer("e3_test_samples_per_class", 20)

if not CAMPAIGN_ID:
    raise ValueError("e3_campaign_id must be supplied through --config.")
if not PROFILE:
    raise ValueError("e3_profile must not be empty.")
if not 0.0 <= MINIMUM_MEAN_PLDDT <= 100.0:
    raise ValueError("e3_minimum_mean_plddt must be between 0 and 100.")
if WORK_DIR in (Path("/"), Path.home().resolve()):
    raise ValueError(f"Unsafe e3_work_dir: {WORK_DIR}")
if PREPARED_DIR in REVIEWED_LABELS.parents or REVIEWED_LABELS == PREPARED_DIR:
    raise ValueError("Reviewed labels must be outside the immutable prepared-input bundle.")

PREPARATION_MARKER = STATE_DIR / "01_preparation" / "PREPARED_VERIFIED.json"
REVIEW_MARKER = STATE_DIR / "02_label_review" / "REVIEW_READY.json"
AUTOMATED_LABELS_PATH = WORK_DIR / "AUTOMATED_TEST_ONLY.label_assignments.tsv"
AUTOMATED_LABELS_MARKER = (
    STATE_DIR / "02_label_review" / "AUTOMATED_TEST_ONLY.LABELS.json"
)
AUTOMATED_APPROVAL_MARKER = (
    STATE_DIR / "02_label_review" / "AUTOMATED_TEST_ONLY.REVIEW_APPROVED.json"
)
EVIDENCE_BUNDLE_DIR = WORK_DIR / "evidence_label_bundle"
EVIDENCE_LABELS_PATH = EVIDENCE_BUNDLE_DIR / "label_assignments.tsv"
EVIDENCE_LABELS_MARKER = EVIDENCE_BUNDLE_DIR / "EVIDENCE_LABELS.json"
EVIDENCE_ANALYSIS_DOMAINS = EVIDENCE_BUNDLE_DIR / "domains.for_signature_analysis.tsv"
EVIDENCE_APPROVAL_MARKER = (
    STATE_DIR / "02_label_review" / "EVIDENCE_PROVISIONAL.REVIEW_APPROVED.json"
)
REVIEW_VERIFICATION_MARKER = STATE_DIR / "02_label_review" / "REVIEW_VERIFIED.json"
CAMPAIGN_MARKER = STATE_DIR / "03_initialisation" / "CAMPAIGN_VALIDATED.json"
CAMPAIGN_REVALIDATION_MARKER = STATE_DIR / "04_analysis" / "CAMPAIGN_REVALIDATED.json"
ANALYSIS_MARKER = STATE_DIR / "04_analysis" / "RESULT_VERIFIED.json"
FINAL_MARKER = STATE_DIR / "05_verification" / "VERIFIED.json"
LOG_DIR = STATE_DIR / "logs"

if AUTOMATED_TEST_LABELS and EVIDENCE_LED_LABELS:
    raise ValueError(
        "e3_automated_test_labels and e3_evidence_led_labels are mutually exclusive."
    )
if ACCEPT_PROVISIONAL_EVIDENCE and not EVIDENCE_LED_LABELS:
    raise ValueError(
        "e3_accept_provisional_evidence_labels requires e3_evidence_led_labels=true."
    )
if not EVIDENCE_RULES:
    raise ValueError("e3_evidence_rules must not be empty.")
if AUTOMATED_TEST_LABELS:
    if REVIEWED_LABELS != AUTOMATED_LABELS_PATH:
        raise ValueError(
            "Automated test mode requires the fixed AUTOMATED_TEST_ONLY label path."
        )
    if APPROVAL_MARKER != AUTOMATED_APPROVAL_MARKER:
        raise ValueError(
            "Automated test mode requires the fixed AUTOMATED_TEST_ONLY approval path."
        )
    if not TEST_TARGET_LABEL:
        raise ValueError("e3_test_target_label must not be empty.")
    if TEST_SAMPLES_PER_CLASS < 20:
        raise ValueError("e3_test_samples_per_class must be at least 20.")
elif EVIDENCE_LED_LABELS:
    if REVIEWED_LABELS != EVIDENCE_LABELS_PATH:
        raise ValueError(
            "Evidence-led mode requires the fixed evidence-bundle label path."
        )
    if APPROVAL_MARKER != EVIDENCE_APPROVAL_MARKER:
        raise ValueError(
            "Evidence-led mode requires the fixed provisional approval path."
        )
elif REVIEWED_LABELS in {AUTOMATED_LABELS_PATH, EVIDENCE_LABELS_PATH} or (
    APPROVAL_MARKER in {AUTOMATED_APPROVAL_MARKER, EVIDENCE_APPROVAL_MARKER}
):
    raise ValueError("Automated authorities require their matching explicit workflow mode.")

shell.executable("/bin/bash")


