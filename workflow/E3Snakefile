    params:
        sequences=str(PREPARED_DIR / "proteins.faa"),
        review_context=str(PREPARED_DIR / "e3_label_curation_review.tsv"),
        source_domains=str(PREPARED_DIR / "domains.tsv"),
        structures=str(PREPARED_DIR / "structures.tsv"),
        template=str(PREPARED_DIR / "label_assignments.REVIEW_REQUIRED.tsv"),
        orthofinder_results=str(RUN_ROOT / "04_orthofinder" / "Results"),
        profile=PROFILE,
        evidence_rules=EVIDENCE_RULES,
        run_id=CAMPAIGN_ID,
        evidence_mode=("true" if EVIDENCE_LED_LABELS else "false"),
        seed_assignments=optional_cli_argument(
            "--seed-assignments", SEED_ASSIGNMENTS
        ),
        seed_catalogue=optional_cli_argument("--seed-catalogue", SEED_CATALOGUE),
        external_annotations=optional_cli_argument(
            "--external-annotations", EXTERNAL_ANNOTATIONS
        ),
    threads:
        1
    resources:
        mem_mb=64_000,
        runtime=360
    log:
        str(LOG_DIR / "02_create_evidence_labels.log")
    shell:
        """
        set -o pipefail
        mkdir -p -- {LOG_DIR:q}
        if [[ {params.evidence_mode:q} != true ]]; then
            echo 'create_evidence_labels requires e3_evidence_led_labels=true.' >&2
            exit 2
        fi
        protein-signatures create-evidence-labels \
            --sequences-fasta {params.sequences:q} \
            --output-dir {EVIDENCE_BUNDLE_DIR:q} \
            --profile {params.profile:q} \
            --evidence-rules {params.evidence_rules:q} \
            --review-context {params.review_context:q} \
            --domains {params.source_domains:q} \
            --structures {params.structures:q} \
            --template-labels {params.template:q} \
            --orthofinder-results {params.orthofinder_results:q} \
            --orthofinder-group-type HOG \
            --orthofinder-hierarchy-node N0 \
            --orthofinder-run-id {params.run_id:q} \
            --random-seed 1729 \
            --validation-fraction 0.2 \
            {params.seed_assignments} \
            {params.seed_catalogue} \
            {params.external_annotations} \
            --log-level {LOG_LEVEL:q} 2>&1 | tee {log:q}
        """


def label_review_inputs(wildcards):
    """Return mode-specific authorities required before review staging."""

    del wildcards
    values = [str(PREPARATION_MARKER)]
    if EVIDENCE_LED_LABELS:
        values.append(str(EVIDENCE_LABELS_MARKER))
    return values


