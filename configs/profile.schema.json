{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterthorpe5/protein-signature-analysis/configs/profile.schema.json",
  "title": "Protein Signature Analysis classification profile",
  "description": "Profile contract. The Python hierarchy validator remains the executable authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_version", "display_name", "labels"],
  "properties": {
    "profile_id": {"$ref": "#/$defs/identifier"},
    "profile_version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "require_structural_evidence": {"type": "boolean", "default": false},
    "default_comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_root_label_id": {"$ref": "#/$defs/optionalIdentifier"},
        "background_label_id": {"$ref": "#/$defs/optionalIdentifier"},
        "excluded_label_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"},
          "default": []
        },
        "excluded_subtree_label_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"},
          "default": []
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/label"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+/-]{0,254}$"
    },
    "optionalIdentifier": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "display_name",
        "parent_label_id",
        "level",
        "component_role",
        "description"
      ],
      "properties": {
        "label_id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "parent_label_id": {"$ref": "#/$defs/optionalIdentifier"},
        "level": {"$ref": "#/$defs/identifier"},
        "system_class": {"type": "string"},
        "mechanistic_class": {"type": "string"},
        "component_role": {"type": "string"},
        "family": {"type": "string"},
        "active_site_expected": {
          "type": "string",
          "enum": ["YES", "NO", "UNKNOWN"],
          "default": "UNKNOWN"
        },
        "active_site_residue": {"type": "string"},
        "default_analysis": {"type": "boolean", "default": false},
        "default_background_label_id": {"$ref": "#/$defs/optionalIdentifier"},
        "assignment_exclusivity_group": {"$ref": "#/$defs/optionalIdentifier"},
        "reviewed_positive_allowed": {"type": "boolean", "default": true},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
