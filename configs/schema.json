{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterthorpe5/protein-signature-analysis/configs/schema.json",
  "title": "Protein Signature Analysis campaign",
  "description": "Schema version 1. The Python validator remains the executable authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "inputs"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/identifier"},
        "profile": {"type": "string", "minLength": 1, "default": "e3"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequences_fasta", "label_assignments"],
      "properties": {
        "sequences_fasta": {"$ref": "#/$defs/path"},
        "label_assignments": {"$ref": "#/$defs/path"},
        "label_evidence_marker": {"$ref": "#/$defs/optionalPath"},
        "label_evidence_audit": {"$ref": "#/$defs/optionalPath"},
        "control_matching_audit": {"$ref": "#/$defs/optionalPath"},
        "label_definition_features": {"$ref": "#/$defs/optionalPath"},
        "class_labelling_summary": {"$ref": "#/$defs/optionalPath"},
        "unresolved_assignments": {"$ref": "#/$defs/optionalPath"},
        "features": {"$ref": "#/$defs/optionalPath"},
        "domains": {"$ref": "#/$defs/optionalPath"},
        "redundancy_clusters": {"$ref": "#/$defs/optionalPath"},
        "structures": {"$ref": "#/$defs/optionalPath"},
        "structure_comparisons": {"$ref": "#/$defs/optionalPath"},
        "structural_alignment_resource": {"$ref": "#/$defs/optionalPath"},
        "alphafold_accessions": {"$ref": "#/$defs/optionalPath"},
        "orthofinder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_dir": {"$ref": "#/$defs/optionalPath"},
            "results_dir": {"$ref": "#/$defs/optionalPath"},
            "group_type": {
              "type": "string",
              "enum": ["HOG", "LEGACY_ORTHOGROUP"],
              "default": "HOG"
            },
            "hierarchy_node": {"type": "string", "default": "N0"},
            "run_id": {"type": "string", "default": ""}
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kmer_lengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 12},
          "default": [3]
        },
        "minimum_target_proteins": {"type": "integer", "minimum": 1, "default": 3},
        "minimum_background_proteins": {"type": "integer", "minimum": 1, "default": 3},
        "minimum_feature_proteins": {"type": "integer", "minimum": 1, "default": 2},
        "maximum_kmer_features": {"type": "integer", "minimum": 1, "default": 10000},
        "validation_fraction": {"type": "number", "minimum": 0, "maximum": 0.9, "default": 0.2},
        "fdr_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.05},
        "random_seed": {"type": "integer", "minimum": 0, "default": 1729},
        "structural_tm_score_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "structural_minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5}
      }
    },
    "alphafold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "cache_dir": {"type": "string", "minLength": 1, "default": ".protein_signature_cache/alphafold"},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600, "default": 60},
        "retries": {"type": "integer", "minimum": 0, "default": 3},
        "minimum_mean_plddt": {"type": "number", "minimum": 0, "maximum": 100, "default": 50}
      }
    },
    "foldseek": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "executable": {"type": "string", "minLength": 1, "default": "foldseek"},
        "cache_dir": {"type": "string", "minLength": 1, "default": ".protein_signature_cache/foldseek"},
        "e_value_threshold": {"type": "number", "minimum": 0, "default": 0.001},
        "sensitivity": {"type": "number", "minimum": 1, "maximum": 10, "default": 9.5},
        "maximum_hits": {"type": "integer", "minimum": 1, "default": 1000}
      }
    },
    "explainable_ml": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"const": true, "default": true},
        "minimum_samples_per_class": {"type": "integer", "minimum": 2, "default": 10},
        "minimum_groups_per_class": {"type": "integer", "minimum": 2, "default": 3},
        "maximum_features": {"type": "integer", "minimum": 1, "default": 500},
        "regularisation_strengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "minimum": 1e-12},
          "default": [0.01, 0.1, 1.0]
        },
        "l1_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2},
        "cross_validation_folds": {"type": "integer", "minimum": 2, "default": 5},
        "maximum_iterations": {"type": "integer", "minimum": 50, "default": 2000},
        "convergence_tolerance": {"type": "number", "minimum": 1e-12, "maximum": 0.1, "default": 0.0001},
        "permutation_repeats": {"type": "integer", "minimum": 1, "default": 10},
        "maximum_permutation_features": {"type": "integer", "minimum": 1, "default": 50},
        "top_local_explanations": {"type": "integer", "minimum": 1, "default": 10},
        "maximum_waterfall_plots": {"type": "integer", "minimum": 0, "default": 8},
        "plot_cache_dir": {"type": "string", "minLength": 1, "default": ".protein_signature_cache/shap"},
        "exclude_technical_features": {"type": "boolean", "default": true}
      }
    },
    "comparisons": {
      "oneOf": [
        {"const": "profile_defaults"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/comparison"}
        }
      ],
      "default": "profile_defaults"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+/-]{0,254}$"
    },
    "path": {"type": "string", "minLength": 1},
    "optionalPath": {
      "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "target_label_ids", "background_label_ids"],
      "properties": {
        "comparison_id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "target_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "background_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "description": {"type": "string", "default": ""}
      }
    }
  }
}
